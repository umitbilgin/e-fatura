{
  "name": "e-fatura-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.14.1",
  "main": "./packages/e-fatura/dist/index.cjs",
  "module": "./packages/e-fatura/dist/index.mjs",
  "types": "./packages/e-fatura/dist/index.d.ts",
  "exports": {
    "./package.json": "./packages/e-fatura/package.json",
    ".": {
      "import": {
        "types": "./packages/e-fatura/dist/index.d.ts",
        "default": "./packages/e-fatura/dist/index.mjs"
      },
      "require": {
        "types": "./packages/e-fatura/dist/index.d.ts",
        "default": "./packages/e-fatura/dist/index.cjs"
      }
    }
  },
  "dependencies": {
    "axios": "^1.8.3",
    "lodash.merge": "^4.6.2",
    "number-to-text": "^0.3.9",
    "uuid": "^9.0.0"
  },
  "scripts": {
    "preinstall": "bash ./install-hooks.sh",
    "prebuild": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "build": "pnpm run prebuild && pnpm run rollup:build",
    "rollup:build": "NODE_ENV=production rollup -c",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint \"./packages/**/*.ts\" --quiet",
    "lint:fix": "eslint \"./packages/**/*.ts\" --fix",
    "format": "prettier --write \"./packages/**/*.ts\""
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitest/coverage-v8": "^3.0.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.5.1",
    "rollup": "^4.30.1",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-node-externals": "^5.1.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
